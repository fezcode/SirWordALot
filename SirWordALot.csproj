<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SirWordALot</RootNamespace>
    <Version>0.1.1</Version>
    <Company>Fezcode</Company>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/SirWordALot.ico</ApplicationIcon>
    <!-- Symbols go inside the executable rather than beside it, so a release
         payload is one file and no .pdb ships next to the app. -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tools/**;tests/**" />
    <AvaloniaResource Include="Assets/**" Exclude="Assets/dictionary.json.gz" />
    <!-- The offline dictionary exported from atlas.dict. Embedded rather than
         copied beside the exe so the single-file build carries it. -->
    <EmbeddedResource Include="Assets/dictionary.json.gz"
                      LogicalName="SirWordALot.Assets.dictionary.json.gz" />
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Pinned above the versions Microsoft.Data.Sqlite and Avalonia.Desktop pull in
         transitively; both of those carry high-severity advisories (GHSA-2m69-gcr7-jv3q,
         GHSA-xrw6-gwf8-vvr9). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>
</Project>
