<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SirWordALot.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes><ColorPaletteResources x:Key="Light" Accent="#416C5D"/></FluentTheme.Palettes>
    </FluentTheme>
    <!-- Shared with tools/Preview so a rendered screenshot cannot be styled
         differently from the application it claims to show. -->
    <StyleInclude Source="avares://SirWordALot/Shell/Controls.axaml"/>
  </Application.Styles>
</Application>
