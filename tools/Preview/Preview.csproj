<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SirWordALot.Preview</RootNamespace>
    <AssemblyName>SirWordALot.Preview</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Core/**/*.cs" LinkBase="Core" />
    <EmbeddedResource Include="../../Assets/dictionary.json.gz"
                      LogicalName="SirWordALot.Assets.dictionary.json.gz" />
    <Compile Include="../../Shell/**/*.cs" LinkBase="Shell" />
    <Compile Include="../../Views/**/*.cs" LinkBase="Views" />
    <!-- The application's own stylesheet, so previews render exactly what ships. -->
    <AvaloniaResource Include="../../Shell/Controls.axaml" Link="Shell/Controls.axaml" />
    <AvaloniaResource Include="../../Shell/Braun.axaml" Link="Shell/Braun.axaml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.0" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>
</Project>
